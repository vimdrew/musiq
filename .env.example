# musiq configuration — copy this file to `.env` and edit as needed.
#
#   cp .env.example .env
#
# MUSIC_DIR is where downloads are written and where your library lives.
# Change this one line to move your output folder; it is used by
# `musiq download`, `musiq import`, `musiq organize` and the library
# lookups (`view` / `retag` / `fix`).
#
# Override order (highest first):
#   1. MUSIC_DIR environment variable
#   2. .env (this file, once copied)
#   3. ~/.musiq/config
#   4. ~/Music (default)
MUSIC_DIR=~/Music
